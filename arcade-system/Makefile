# ═══════════════════════════════════════════════════════════════════════════
#                              MAKEFILE برای پروژه ARCADE SYSTEM
# ═══════════════════════════════════════════════════════════════════════════
#
# این فایل Makefile را من خودم نوشتم تا تمام بازی‌های C را به صورت خودکار
# کامپایل کند و فایل‌های CGI قابل اجرا تولید کند.
#
# هدف من از این Makefile:
# - خودکارسازی فرآیند build تا هر بار نیازی به تایپ gcc نباشد
# - مدیریت وابستگی‌ها بین فایل‌های مشترک و بازی‌ها
# - ایجاد پوشه cgi-bin به صورت خودکار
# - امکان پاک کردن تمام فایل‌های ساخته شده با یک دستور
#
# چرا Makefile مهم است:
# - بدون آن باید هر بازی را جداگانه کامپایل کنم
# - تغییر در c_utils.c نیاز به rebuild همه بازی‌ها دارد
# - Makefile این وابستگی را مدیریت می‌کند
#
# نحوه استفاده:
#   make          -> کامپایل تمام بازی‌ها
#   make clean    -> پاک کردن تمام فایل‌های .cgi
#   make <game>   -> کامپایل یک بازی خاص (مثل make guess_number.cgi)
#
# یادآوری برای خودم:
# - اگر بازی جدیدی اضافه کردم، باید به TARGETS اضافه کنم
# - اگر فایل مشترک جدیدی ساختم، به SRC_COMMON اضافه کنم
# - همیشه بعد از تغییر Makefile یکبار make clean && make بزن
#
# ───────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════
#                           متغیرهای اصلی و تنظیمات
# ═══════════════════════════════════════════════════════════════════════════

# CC: کامپایلر C که استفاده می‌کنم
# من gcc را انتخاب کردم چون رایگان، قدرتمند و در همه جا موجود است
CC = gcc

# CFLAGS: پرچم‌های کامپایلر
# - Wall: تمام warning‌های معمول را فعال می‌کند (به من کمک می‌کند باگ کمتر داشته باشم)
# - Wextra: warning‌های اضافی برای کد تمیزتر
# - I src/common: مسیر برای پیدا کردن فایل‌های هدر (c_utils.h)
#   این به این معنی است که می‌توانم در بازی‌ها بنویسم: #include "../common/c_utils.h"
CFLAGS = -Wall -Wextra -I src/common

# CGI_BIN: پوشه‌ای که فایل‌های CGI قابل اجرا در آن قرار می‌گیرند
# این پوشه باید در مسیر سرور CGI قرار گیرد تا قابل اجرا باشند
# اگر این مسیر را تغییر بدهم، باید مطمئن شوم سرور هم به مسیر جدید اشاره دارد
CGI_BIN = cgi-bin

# SRC_COMMON: فایل‌های مشترکی که با همه بازی‌ها لینک می‌شوند
# فعلاً فقط c_utils.c داریم ولی اگر فایل کمکی جدیدی اضافه کنم، اینجا می‌نویسم
# این فایل شامل توابع get_param، print_header، print_footer است
SRC_COMMON = src/common/c_utils.c

# ═══════════════════════════════════════════════════════════════════════════
#                         لیست تمام بازی‌های قابل ساخت
# ═══════════════════════════════════════════════════════════════════════════

# TARGETS: لیست کامل فایل‌های CGI که باید ساخته شوند
# هر خط یک بازی است که پس از کامپایل در پوشه cgi-bin قرار می‌گیرد
# اگر بازی جدیدی اضافه کنم، حتماً باید اینجا بنویسمش
#
# فرمت هر خط: $(CGI_BIN)/<game>.cgi \
# backslash در آخر یعنی ادامه در خط بعد (برای خوانایی)
#
# بازی‌های فعلی:
# 1. guess_number.cgi     -> بازی حدس عدد (3 سطح دشواری)
# 2. rps_5move.cgi        -> سنگ کاغذ قیچی 5 حرکتی (شلدون)
# 3. tictactoe_limited.cgi -> دوز محدود (هر نفر فقط 3 مهره)
# 4. hangman_battle.cgi   -> نبرد کلمات (حدس کلمه)
# 5. fibonacci_2048.cgi   -> 2048 با دنباله فیبوناچی
# 6. checkers.cgi         -> چکرز (با قانون forced jump)
# 7. chess_modified.cgi   -> شطرنج با مهره‌های جدید (Dragon, Thief, Gryphon)
TARGETS = $(CGI_BIN)/guess_number.cgi \
          $(CGI_BIN)/rps_5move.cgi \
          $(CGI_BIN)/tictactoe_limited.cgi \
          $(CGI_BIN)/hangman_battle.cgi \
		  $(CGI_BIN)/fibonacci_2048.cgi \
		  $(CGI_BIN)/checkers.cgi \
		  $(CGI_BIN)/chess_modified.cgi

# ═══════════════════════════════════════════════════════════════════════════
#                              قوانین ساخت (Build Rules)
# ═══════════════════════════════════════════════════════════════════════════

# قانون پیش‌فرض: وقتی فقط `make` می‌زنم، تمام بازی‌ها ساخته می‌شوند
# این قانون همه را به $(TARGETS) متصل می‌کند
all: $(TARGETS)

# ───────────────────────────────────────────────────────────────────────────
#                      قانون ساخت: بازی حدس عدد
# ───────────────────────────────────────────────────────────────────────────
# این بازی ساده است و فقط یک فایل C دارد
# وابستگی‌ها: guess_number.c و c_utils.c
#
# @mkdir -p $(CGI_BIN) -> اگر پوشه cgi-bin نبود، ایجاد کن
#   @ در اول یعنی خود دستور را چاپ نکن (فقط نتیجه)
#   -p یعنی خطا نده اگر قبلاً وجود داشت
#
# $(CC) $(CFLAGS) -o $@ ... -> دستور کامپایل
#   $@ = نام target (یعنی cgi-bin/guess_number.cgi)
#   $^ = تمام dependency‌ها (هر دو فایل .c)
$(CGI_BIN)/guess_number.cgi: src/games/guess_number.c $(SRC_COMMON)
	@mkdir -p $(CGI_BIN)
	$(CC) $(CFLAGS) -o $@ src/games/guess_number.c $(SRC_COMMON)

# ───────────────────────────────────────────────────────────────────────────
#                   قانون ساخت: سنگ کاغذ قیچی 5 حرکتی
# ───────────────────────────────────────────────────────────────────────────
# این بازی قوانین شلدون را پیاده می‌کند (سنگ، کاغذ، قیچی، مارمولک، اسپاک)
$(CGI_BIN)/rps_5move.cgi: src/games/rps_5move.c $(SRC_COMMON)
	$(CC) $(CFLAGS) -o $@ src/games/rps_5move.c $(SRC_COMMON)

# ───────────────────────────────────────────────────────────────────────────
#                         قانون ساخت: شطرنج تغییریافته
# ───────────────────────────────────────────────────────────────────────────
# این بازی پیچیده‌تر است و شامل چند فایل است:
# - main.c: نقطه ورود و مدیریت CGI
# - logic.c: منطق حرکات و قوانین شطرنج
# - state.c: مدیریت وضعیت تخته
#
# $^ در اینجا به معنای تمام dependency‌هاست (هر 4 فایل)
# ترتیب مهم است: main باید اول باشد چون تابع main در آن است
$(CGI_BIN)/chess_modified.cgi: src/games/chess/main.c src/games/chess/logic.c src/games/chess/state.c $(SRC_COMMON)
	$(CC) $(CFLAGS) -o $@ $^

# ───────────────────────────────────────────────────────────────────────────
#                       قانون ساخت: دوز محدود
# ───────────────────────────────────────────────────────────────────────────
# نسخه خاص Tic Tac Toe که هر بازیکن فقط 3 مهره دارد
# مهره چهارم، اولی را حذف می‌کند (FIFO)
$(CGI_BIN)/tictactoe_limited.cgi: src/games/tictactoe_limited.c $(SRC_COMMON)
	$(CC) $(CFLAGS) -o $@ src/games/tictactoe_limited.c $(SRC_COMMON)

# ───────────────────────────────────────────────────────────────────────────
#                      قانون ساخت: فیبوناچی 2048
# ───────────────────────────────────────────────────────────────────────────
# نسخه خاص 2048 که به جای 2، 4، 8، ... از دنباله فیبوناچی استفاده می‌کند
# ادغام‌ها فقط برای اعداد مجاور در دنباله فیبوناچی مجاز است
$(CGI_BIN)/fibonacci_2048.cgi: src/games/fibonacci_2048.c $(SRC_COMMON)
	$(CC) $(CFLAGS) -o $@ src/games/fibonacci_2048.c $(SRC_COMMON)

# ───────────────────────────────────────────────────────────────────────────
#                           قانون ساخت: چکرز
# ───────────────────────────────────────────────────────────────────────────
# بازی چکرز کلاسیک با قانون Forced Jump (پرش اجباری)
# شامل چند فایل است:
# - main.c: مدیریت CGI و رندر HTML
# - logic.c: منطق بازی و اعتبارسنجی حرکات
# - state.c: مدیریت وضعیت تخته و مهره‌ها
$(CGI_BIN)/checkers.cgi: src/games/checkers/main.c src/games/checkers/logic.c src/games/checkers/state.c $(SRC_COMMON)
	$(CC) $(CFLAGS) -o $@ $^

# ───────────────────────────────────────────────────────────────────────────
#                         قانون ساخت: نبرد کلمات
# ───────────────────────────────────────────────────────────────────────────
# بازی Hangman (حدس کلمه) با حالت تک‌نفره و دونفره
# @echo در آخر پیامی چاپ می‌کند که build موفق بوده
$(CGI_BIN)/hangman_battle.cgi: src/games/hangman_battle.c $(SRC_COMMON)
	$(CC) $(CFLAGS) -o $@ src/games/hangman_battle.c $(SRC_COMMON)
	@echo "Build successful: hangman_battle.cgi"

# ═══════════════════════════════════════════════════════════════════════════
#                         قانون تمیزکاری (Clean Rule)
# ═══════════════════════════════════════════════════════════════════════════

# clean: پاک کردن تمام فایل‌های CGI ساخته شده
# این قانون را وقتی می‌زنم که می‌خواهم همه چیز را از نو بسازم
#
# rm -f $(CGI_BIN)/*.cgi
#   -f = force (خطا نده اگر فایلی وجود نداشت)
#   *.cgi = تمام فایل‌های با پسوند .cgi
#
# نحوه استفاده:
#   make clean        -> پاک کردن همه
#   make clean && make -> ساخت کامل از نو
#
# چرا clean مهم است:
# - بعضی وقت‌ها فایل‌های قدیمی باعث مشکل می‌شوند
# - اگر تغییرات در هدر بدهم، باید rebuild کنم
# - برای اطمینان از اینکه آخرین نسخه ساخته شده
clean:
	rm -f $(CGI_BIN)/*.cgi

# ═══════════════════════════════════════════════════════════════════════════
#                               پایان Makefile
# ═══════════════════════════════════════════════════════════════════════════
#
# خلاصه دستورات مفید:
#   make            -> کامپایل همه بازی‌ها
#   make clean      -> پاک کردن فایل‌های ساخته شده
#   make <game>.cgi -> کامپایل یک بازی خاص
#
# یادآوری نهایی:
# - همیشه بعد از تغییر در c_utils.* یکبار `make clean && make` بزن
# - اگر بازی جدید اضافه کردی، حتماً به TARGETS اضافه کن
# - پوشه cgi-bin باید در مسیر سرور CGI باشد
# - فایل‌های .cgi باید قابل اجرا باشند (chmod +x)
#
# ساخته شده با ❤️ برای پروژه Arcade System
# تاریخ: دی ۱۴۰۴
#
